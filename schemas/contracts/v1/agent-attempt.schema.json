{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpaca-agent.local/schemas/contracts/v1/agent-attempt.schema.json",
  "title": "agent-attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "inputHash",
    "inputReferences",
    "requestedProvider",
    "requestedModel",
    "reasoningSetting",
    "versions",
    "startedAt",
    "timeoutAt",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "attemptId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "inputHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "inputReferences": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "requestedProvider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requestedModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reasoningSetting": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowDefinition",
        "contractSchema",
        "policy",
        "innerProfile",
        "featureCalculation",
        "prompt",
        "requestedModel",
        "resolvedModel",
        "reasoningConfiguration",
        "runtimeConnectorProviderSdk",
        "deterministicDecisionLogic",
        "persistenceMapping"
      ],
      "properties": {
        "workflowDefinition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "contractSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "innerProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "featureCalculation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "requestedModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "resolvedModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "reasoningConfiguration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "runtimeConnectorProviderSdk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "deterministicDecisionLogic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "persistenceMapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "timeoutAt": {
      "type": "string",
      "format": "date-time"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolCount",
        "hasSession",
        "hasThread",
        "hasMemory",
        "hasHandoffs",
        "hasPreviousResponseChaining"
      ],
      "properties": {
        "toolCount": {
          "const": 0
        },
        "hasSession": {
          "const": false
        },
        "hasThread": {
          "const": false
        },
        "hasMemory": {
          "const": false
        },
        "hasHandoffs": {
          "const": false
        },
        "hasPreviousResponseChaining": {
          "const": false
        }
      }
    }
  }
}
