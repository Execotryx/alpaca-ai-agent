{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpaca-agent.local/schemas/contracts/v1/policy-assessment.schema.json",
  "title": "policy-assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inputContentHash",
    "supportingFactors",
    "opposingFactors",
    "conflicts",
    "missingOrUnreliableInformation",
    "policy",
    "declaredConfidence",
    "uncertaintyCategory"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "inputContentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "supportingFactors": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidenceIds"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "evidenceIds": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "opposingFactors": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidenceIds"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "evidenceIds": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidenceIds"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "evidenceIds": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "missingOrUnreliableInformation": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "policy": {
      "enum": [
        "Skip",
        "ConservativeCall",
        "BalancedCall",
        "IncomeCall",
        "InsufficientInformation"
      ]
    },
    "declaredConfidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertaintyCategory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
