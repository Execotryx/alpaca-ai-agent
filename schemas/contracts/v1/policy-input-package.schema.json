{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpaca-agent.local/schemas/contracts/v1/policy-input-package.schema.json",
  "title": "policy-input-package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "symbol",
    "decisionTime",
    "contentHash",
    "marketSnapshotId",
    "accountSnapshotId",
    "reconciledPortfolioId",
    "evidenceBundleId",
    "features",
    "readOnlyPortfolioSummary",
    "allowedPolicies",
    "versions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "decisionTime": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "marketSnapshotId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "accountSnapshotId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "reconciledPortfolioId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "evidenceBundleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "features": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "calculationVersion",
          "provenance"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "known",
                  "unknown",
                  "unavailable",
                  "invalid"
                ]
              },
              "value": {
                "type": "number"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "calculationVersion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "readOnlyPortfolioSummary": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "allowedPolicies": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy",
          "description",
          "profileReference"
        ],
        "properties": {
          "policy": {
            "enum": [
              "Skip",
              "ConservativeCall",
              "BalancedCall",
              "IncomeCall",
              "InsufficientInformation"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "profileReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowDefinition",
        "contractSchema",
        "policy",
        "innerProfile",
        "featureCalculation",
        "prompt",
        "requestedModel",
        "resolvedModel",
        "reasoningConfiguration",
        "runtimeConnectorProviderSdk",
        "deterministicDecisionLogic",
        "persistenceMapping"
      ],
      "properties": {
        "workflowDefinition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "contractSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "innerProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "featureCalculation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "requestedModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "resolvedModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "reasoningConfiguration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "runtimeConnectorProviderSdk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "deterministicDecisionLogic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "persistenceMapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    }
  }
}
