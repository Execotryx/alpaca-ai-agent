    { "field": "maximumDte", "boundary": 45, "inside": 45, "outside": 46 },
    { "field": "minimumDelta", "boundary": 0.10, "inside": 0.10, "outside": 0.09 },
    { "field": "maximumDelta", "boundary": 0.40, "inside": 0.40, "outside": 0.41 },
    { "field": "maximumSpreadRatio", "boundary": 0.15, "inside": 0.15, "outside": 0.16 },
