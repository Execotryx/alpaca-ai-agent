{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 17,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["fixtureId", "schemaVersion", "scenario", "decisionTime", "sourceTimes", "canonicalOrderingRule", "canonicalContentHash", "provenance", "expectedValidationState", "owningTests", "immutable", "payload"],
    "properties": {
      "fixtureId": { "type": "string", "pattern": "^FX-[A-Z0-9-]+$" },
      "schemaVersion": { "const": "1.0" },
      "scenario": { "type": "string", "minLength": 1 },
      "decisionTime": { "type": "string", "format": "date-time" },
      "sourceTimes": { "type": "array", "items": { "type": "string", "format": "date-time" } },
      "canonicalOrderingRule": { "const": "ordinal-property-order;preserve-array-order;invariant-numbers;utc-instants" },
      "canonicalContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "provenance": { "type": "string", "minLength": 1 },
      "expectedValidationState": { "enum": ["VALID", "INVALID", "UNAVAILABLE", "UNKNOWN"] },
      "owningTests": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(UT-[0-9]{3}|P3-[A-Z]+-[0-9]{3})$" } },
      "immutable": { "const": true },
      "payload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedOutcome", "classification", "assertions"],
        "properties": {
          "expectedOutcome": { "type": "string", "minLength": 1 },
          "classification": { "type": "string", "minLength": 1 },
          "assertions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
